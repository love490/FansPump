DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iopn_launch?schema=public"

# OPNChain Testnet
NEXT_PUBLIC_CHAIN_ID=984
# Comma-separated for failover, e.g. https://testnet-rpc.iopn.tech/,https://testnet-rpc2.iopn.tech/
# Leave unset to use both official endpoints automatically.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.iopn.tech/

NEXT_PUBLIC_FACTORY_ADDRESS=0xe93B7E9d8B5e6b4676d78693C24794A66F8Bb9AC
# REQUIRED for token creation — set to your deployed IOPnTokenFactory on OPN Testnet (not zero address)
NEXT_PUBLIC_LIQUIDITY_ROUTER_ADDRESS=0xB489bce5c9c9364da2D1D1Bc5CE4274F63141885
# Uniswap V2-compatible DEX router for swaps (required for /swap)
NEXT_PUBLIC_DEX_ROUTER_ADDRESS=0xB489bce5c9c9364da2D1D1Bc5CE4274F63141885
# Wrapped native OPN (WOPN)
NEXT_PUBLIC_WETH_ADDRESS=0xBc022C9dEb5AF250A526321d16Ef52E39b4DBD84
# OPN Testnet ecosystem tokens (defaults used when unset)
NEXT_PUBLIC_WOPN_ADDRESS=0xBc022C9dEb5AF250A526321d16Ef52E39b4DBD84
NEXT_PUBLIC_OPNT_ADDRESS=0x2aEc1Db9197Ff284011A6A1d0752AD03F5782B0d
NEXT_PUBLIC_USDT_ADDRESS=0x3e01b4d892E0D0A219eF8BBe7e260a6bc8d9B31b
NEXT_PUBLIC_USDT_DECIMALS=18
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_DECIMALS=6
NEXT_PUBLIC_OPNV2_ADDRESS=0xA463ce9F738E0B4035D8d036B902D0efADb24d20
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Liquidity lock (optional): deploy FansPumpLiquidityLocker and set address
NEXT_PUBLIC_LIQUIDITY_LOCKER_ADDRESS=0x0000000000000000000000000000000000000000
# Signed message prefix for recording lock/burn actions (optional)
NEXT_PUBLIC_LIQUIDITY_MESSAGE_PREFIX="FansPump Liquidity Action"

# Social links (footer)
NEXT_PUBLIC_SOCIAL_X_URL=https://x.com/fanspump
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@fanspump
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@fanspump
VERIFICATION_MESSAGE_PREFIX="FansPump Creator Verification"
# Image uploads (recommended in production / Vercel)
# Create a Blob store and set this token in Vercel project env vars.
BLOB_READ_WRITE_TOKEN=
# Comma-separated platform admin wallets (server-only)
# This wallet should be the fee recipient / factory admin.
ADMIN_WALLET_ADDRESSES=0xD6671336A188971957d1ef722b3C4C1E12B2a1F1
# Optional: on-chain factory admin (defaults to first ADMIN_WALLET_ADDRESSES entry)
FACTORY_ADMIN_ADDRESS=0xD6671336A188971957d1ef722b3C4C1E12B2a1F1
ADMIN_MESSAGE_PREFIX="FansPump Admin Authorization"
