DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iopn_launch?schema=public
PORT=3001
NODE_ENV=development

# Cloudflare R2 — required for /api/upload (token logos, banners, profile avatars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Platform admin bootstrap (first deploy creates this account)
ADMIN_BOOTSTRAP_EMAIL=admin@fanspump.app
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Optional: share admin session cookie across subdomains (only if web calls API directly, not via proxy)
# ADMIN_COOKIE_DOMAIN=.fanspump.xyz

CORS_ORIGINS=https://fanspump.xyz,https://www.fanspump.xyz,https://admin.fanspump.xyz,http://localhost:3000

# Wallet verification (email OTP, NeoID stub, quest social OAuth)
RESEND_API_KEY=
RESEND_FROM=FansPump <noreply@fanspump.xyz>
OTP_SALT=change_me_to_a_long_random_secret
TOKEN_ENCRYPTION_KEY=
# 32-byte hex key (64 chars) for encrypting OAuth tokens at rest

# X (Twitter) OAuth — quest social verification
X_CLIENT_ID=
X_CLIENT_SECRET=
# Legacy aliases also supported: TWITTER_CLIENT_ID, TWITTER_CLIENT_SECRET

# Discord OAuth — quest social verification
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URLs (OAuth redirects)
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
