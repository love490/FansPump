DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iopn_launch?schema=public
PORT=3001
NODE_ENV=development

# Cloudflare R2 — required for /api/upload (token logos, banners, profile avatars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Platform admin bootstrap (first deploy creates this account)
ADMIN_BOOTSTRAP_EMAIL=admin@fanspump.app
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Optional: share admin session cookie across subdomains (only if web calls API directly, not via proxy)
# ADMIN_COOKIE_DOMAIN=.fanspump.xyz

CORS_ORIGINS=https://fanspump.xyz,https://www.fanspump.xyz,https://admin.fanspump.xyz,http://localhost:3000

# Public URLs (OAuth redirects — required for sign-in + social connect)
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# ── Sign in with Google / GitHub (auth modal) ───────────────────────────────
# Google Cloud Console → OAuth 2.0 Client
# Callback: {API_PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub → Settings → Developer settings → OAuth Apps
# Callback: {API_PUBLIC_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional sign-in providers (same callback pattern: /api/auth/oauth/{provider}/callback)
# X / Twitter — X_CLIENT_* or TWITTER_CLIENT_* (same keys as quest social connect below)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# ── Wallet verification (email OTP) ─────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=FansPump <noreply@fanspump.xyz>
OTP_SALT=change_me_to_a_long_random_secret
# 32-byte hex key (64 chars) for encrypting OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=

# ── X / Discord OAuth (sign-in, Settings linked accounts, quest social connect) ─
X_CLIENT_ID=
X_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
