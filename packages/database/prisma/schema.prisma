generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VoteType {
  BULLISH
  NEUTRAL
  BEARISH
}

enum EarningType {
  TRADING_FEE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
  VIEWER
}

enum TokenVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum TreasuryWalletType {
  EOA
  SAFE_MULTISIG
}

enum TokenCategory {
  MEME
  GAMING
  AI
  DEFI
  INFRASTRUCTURE
  NFT
  COMMUNITY
  UTILITY
  OTHER
}

enum AnnouncementType {
  VERSION_RELEASE
  PARTNERSHIP
  LIQUIDITY_ADDED
  EXCHANGE_LISTING
  MARKETING_UPDATE
  COMMUNITY_UPDATE
  GENERAL
}

enum StakingAssetType {
  OPN
  LP_TOKEN
}

enum CreatorStatus {
  ANONYMOUS
  VERIFIED
  TRUSTED
}

enum QuestType {
  SOCIAL
  ENGAGEMENT
  GROWTH
  COMMUNITY
}

enum QuestStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum BountyStatus {
  ACTIVE
  ENDED
  COMPLETED
  CANCELLED
}

enum BountyRewardType {
  OPN
  TOKEN
  CUSTOM
  XP
}

enum BountyTaskType {
  SOCIAL
  ENGAGEMENT
  GROWTH
  CONTENT
  REFERRAL
  COMMUNITY
  CUSTOM
}

enum BountyVerificationMethod {
  MANUAL
  ONCHAIN
  API
}

enum BountyParticipationStatus {
  JOINED
  SUBMITTED
  VERIFIED
  REJECTED
  CLAIMED
}

model User {
  id              String   @id @default(cuid())
  walletAddress   String   @unique @map("wallet_address")
  username        String?  @map("username")
  profileImageUrl String?  @map("profile_image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  watchlist         WatchlistItem[]
  registryWatchlist RegistryWatchlistItem[]
  votes         TokenVote[]
  verification  CreatorVerification?
  tokenProjects TokenProject[]
  bounties      Bounty[]
  bountyParticipations BountyParticipation[]
  followingCreators    CreatorFollow[] @relation("UserFollowing")
  followers            CreatorFollow[] @relation("UserFollowers")

  @@index([username])
  @@map("users")
}

model CreatorFollow {
  id             String   @id @default(cuid())
  followerWallet String   @map("follower_wallet")
  creatorWallet  String   @map("creator_wallet")
  createdAt      DateTime @default(now()) @map("created_at")

  follower User @relation("UserFollowing", fields: [followerWallet], references: [walletAddress], onDelete: Cascade)
  creator  User @relation("UserFollowers", fields: [creatorWallet], references: [walletAddress], onDelete: Cascade)

  @@unique([followerWallet, creatorWallet])
  @@index([followerWallet])
  @@index([creatorWallet])
  @@map("creator_follows")
}

model TokenProject {
  id              String   @id @default(cuid())
  contractAddress String   @unique @map("contract_address")
  chainId         Int      @map("chain_id")
  name            String
  symbol          String
  decimals        Int      @default(18)
  initialSupply   String   @map("initial_supply")
  featureFlags    BigInt   @map("feature_flags")
  creatorAddress  String   @map("creator_address")
  factoryAddress  String   @map("factory_address")
  txHash          String?  @map("tx_hash")

  logoUrl         String?  @map("logo_url")
  bannerUrl       String?  @map("banner_url")
  description     String?  @db.Text
  website         String?
  telegram        String?
  twitter         String?
  discord         String?
  github          String?

  buyTaxBps       Int?     @map("buy_tax_bps")
  sellTaxBps      Int?     @map("sell_tax_bps")
  maxWallet       String?  @map("max_wallet")
  maxTx           String?  @map("max_tx")

  viewCount       Int      @default(0) @map("view_count")
  holderCount     Int      @default(0) @map("holder_count")
  isFeatured      Boolean  @default(false) @map("is_featured")
  trendingScore   Float    @default(0) @map("trending_score")
  verificationStatus TokenVerificationStatus @default(NONE) @map("verification_status")
  verificationSubmittedAt DateTime? @map("verification_submitted_at")
  isHidden        Boolean  @default(false) @map("is_hidden")
  isScam          Boolean  @default(false) @map("is_scam")

  volume24h       Float    @default(0) @map("volume_24h")
  volumeTotal     Float    @default(0) @map("volume_total")
  txCount24h      Int      @default(0) @map("tx_count_24h")
  txCountTotal    Int      @default(0) @map("tx_count_total")
  lastActivity    DateTime? @map("last_activity")
  poolStrength    Float    @default(0) @map("pool_strength")
  category        TokenCategory @default(OTHER)
  ownershipRenounced Boolean @default(false) @map("ownership_renounced")
  trustScore      Float    @default(0) @map("trust_score")
  trustScoreUpdatedAt DateTime? @map("trust_score_updated_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator         User?    @relation(fields: [creatorAddress], references: [walletAddress])
  votes           TokenVote[]
  watchlist       WatchlistItem[]
  metadataHistory MetadataUpdate[]
  liquidityLocks  LiquidityLock[]
  lpBurns         LpBurn[]
  creatorEarnings CreatorEarning[]
  poolStats       TokenPoolStats?
  swapActivities  SwapActivity[]
  announcements   TokenAnnouncement[]
  trustScoreHistory TrustScoreHistory[]
  dailySnapshots  TokenDailySnapshot[]
  quests          CreatorQuest[]
  bounties        Bounty[]

  @@index([category])
  @@index([trustScore])

  @@index([createdAt])
  @@index([volume24h])
  @@index([txCount24h])
  @@index([lastActivity])
  @@index([poolStrength])
  @@index([chainId])
  @@index([creatorAddress])
  @@index([chainId, creatorAddress])
  @@index([chainId, createdAt])
  @@index([trendingScore])
  @@index([viewCount])
  @@index([holderCount])
  @@index([updatedAt])
  @@index([isFeatured])
  @@map("token_projects")
}

model LiquidityLock {
  id            String   @id @default(cuid())
  tokenId       String   @map("token_id")
  tokenAddress  String   @map("token_address")
  lpToken       String   @map("lp_token")
  lockerAddress String   @map("locker_address")
  creatorWallet String   @map("creator_wallet")
  amount        String   @map("amount") // raw LP amount (uint256) as string
  unlockAt      DateTime @map("unlock_at")
  txHash        String?  @map("tx_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  token         TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([tokenAddress])
  @@index([lpToken])
  @@index([creatorWallet])
  @@index([unlockAt])
  @@map("liquidity_locks")
}

model LpBurn {
  id            String   @id @default(cuid())
  tokenId       String   @map("token_id")
  tokenAddress  String   @map("token_address")
  lpToken       String   @map("lp_token")
  creatorWallet String   @map("creator_wallet")
  amount        String   @map("amount") // raw LP amount (uint256) as string
  burnAddress   String   @default("0x000000000000000000000000000000000000dEaD") @map("burn_address")
  txHash        String?  @map("tx_hash")
  burnedAt      DateTime @default(now()) @map("burned_at")

  token         TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([tokenAddress])
  @@index([lpToken])
  @@index([creatorWallet])
  @@map("lp_burns")
}

model CreatorVerification {
  id              String   @id @default(cuid())
  walletAddress   String   @unique @map("wallet_address")
  signature       String
  message         String
  verifiedAt      DateTime @default(now()) @map("verified_at")

  user            User     @relation(fields: [walletAddress], references: [walletAddress])

  @@map("creator_verifications")
}

model WatchlistItem {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  tokenId       String   @map("token_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@map("watchlist_items")
}

model RegistryWatchlistItem {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  registryKey String   @map("registry_key")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, registryKey])
  @@map("registry_watchlist_items")
}

model TokenVote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenId   String   @map("token_id")
  voteType  VoteType @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@map("token_votes")
}

model MetadataUpdate {
  id        String   @id @default(cuid())
  tokenId   String   @map("token_id")
  field     String
  createdAt DateTime @default(now()) @map("created_at")

  token     TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@map("metadata_updates")
}

/// Off-chain creator trading fee ledger (event-indexed, not on-chain yet).
model CreatorEarning {
  id             String      @id @default(cuid())
  creatorAddress String      @map("creator_address")
  tokenId        String      @map("token_id")
  tokenAddress   String      @map("token_address")
  amount         String
  earningType    EarningType @default(TRADING_FEE) @map("earning_type")
  txHash         String?     @map("tx_hash")
  logIndex       Int?        @map("log_index")
  blockNumber    BigInt?     @map("block_number")
  createdAt      DateTime    @default(now()) @map("created_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([creatorAddress])
  @@index([tokenAddress])
  @@index([tokenId])
  @@index([createdAt])
  @@map("creator_earnings")
}

/// Simulated pool share accumulator (AMM migration prep — off-chain only).
model TokenPoolStats {
  id                   String   @id @default(cuid())
  tokenId              String   @unique @map("token_id")
  tokenAddress         String   @unique @map("token_address")
  accumulatedPoolValue String   @default("0") @map("accumulated_pool_value")
  poolReserveEstimate  String   @default("0") @map("pool_reserve_estimate")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenAddress])
  @@map("token_pool_stats")
}

/// Indexed swap activity for analytics (deduped by tx + log index).
model SwapActivity {
  id            String   @id @default(cuid())
  tokenId       String   @map("token_id")
  tokenAddress  String   @map("token_address")
  traderAddress String   @map("trader_address")
  volumeWei     String   @map("volume_wei")
  txHash        String   @map("tx_hash")
  logIndex      Int      @map("log_index")
  blockNumber   BigInt   @map("block_number")
  blockTime     DateTime @map("block_time")
  createdAt     DateTime @default(now()) @map("created_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([tokenAddress])
  @@index([traderAddress])
  @@index([blockTime])
  @@index([tokenId])
  @@map("swap_activities")
}

/// Platform-wide treasury fee accumulator (off-chain ledger).
model PlatformTreasuryLedger {
  id        String      @id @default("global")
  totalWei  String      @default("0") @map("total_wei")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("platform_treasury_ledger")
}

model AdminProfile {
  id            String    @id @default(cuid())
  walletAddress String    @unique @map("wallet_address")
  role          AdminRole @default(SUPER_ADMIN)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("admin_profiles")
}

model Admin {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String    @map("password_hash")
  role                 AdminRole @default(ADMIN)
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret")
  twoFactorBackupCodes String[]  @default([]) @map("two_factor_backup_codes")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  lastLogin            DateTime? @map("last_login")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  sessions     AdminSession[]
  activityLogs AdminActivityLog[]

  @@map("admins")
}

model AdminSession {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  tokenHash  String   @unique @map("token_hash")
  csrfToken  String   @map("csrf_token")
  pending2FA Boolean  @default(false) @map("pending_2fa")
  expiresAt  DateTime @map("expires_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  adminId     String?  @map("admin_id")
  adminEmail  String   @default("unknown") @map("admin_email")
  adminWallet String?  @map("admin_wallet")
  action      String
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([adminEmail])
  @@index([adminWallet])
  @@index([createdAt])
  @@index([action])
  @@map("admin_activity_logs")
}

model TokenAnnouncement {
  id            String           @id @default(cuid())
  tokenId       String           @map("token_id")
  tokenAddress  String           @map("token_address")
  creatorWallet String           @map("creator_wallet")
  title         String
  content       String           @db.Text
  type          AnnouncementType
  isHidden      Boolean          @default(false) @map("is_hidden")
  createdAt     DateTime         @default(now()) @map("created_at")

  token         TokenProject     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([tokenAddress])
  @@index([creatorWallet])
  @@index([createdAt])
  @@map("token_announcements")
}

/// Off-chain stake position tracking (no reward distribution yet).
model StakingPosition {
  id           String           @id @default(cuid())
  wallet       String
  assetType    StakingAssetType @map("asset_type")
  asset        String
  amount       String
  poolAddress  String?          @map("pool_address")
  tokenAddress String?          @map("token_address")
  tier         String?
  stakedAt     DateTime         @default(now()) @map("staked_at")
  unstakedAt   DateTime?        @map("unstaked_at")
  isActive     Boolean          @default(true) @map("is_active")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([wallet])
  @@index([asset])
  @@index([poolAddress])
  @@index([tokenAddress])
  @@index([isActive])
  @@map("staking_positions")
}

/// DEX liquidity pool registry (read-only analytics — AMM migration prep).
model LiquidityPool {
  id              String    @id @default(cuid())
  poolAddress     String    @unique @map("pool_address")
  token0          String    @map("token0")
  token1          String    @map("token1")
  token0Symbol    String?   @map("token0_symbol")
  token1Symbol    String?   @map("token1_symbol")
  pairType        String    @default("OPN_TOKEN") @map("pair_type")
  totalLiquidity  String    @default("0") @map("total_liquidity")
  totalVolume     String    @default("0") @map("total_volume")
  providerCount   Int       @default(0) @map("provider_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  indexedAt       DateTime? @map("indexed_at")

  @@index([token0])
  @@index([token1])
  @@index([pairType])
  @@map("liquidity_pools")
}

/// Key-value platform configuration (fees, treasury, discovery weights, etc.).
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Off-chain creator reputation profile (auto-created for every token creator).
model CreatorProfile {
  walletAddress    String        @id @map("wallet_address")
  status           CreatorStatus @default(ANONYMOUS)
  reputationScore  Int           @default(0) @map("reputation_score")
  fansPumpXp       Int           @default(0) @map("fans_pump_xp")
  badges           String[]      @default([])
  isFeatured       Boolean       @default(false) @map("is_featured")
  totalViews       Int           @default(0) @map("total_views")
  questsCompleted  Int           @default(0) @map("quests_completed")
  joinedAt         DateTime      @default(now()) @map("joined_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  quests CreatorQuest[]

  @@index([reputationScore])
  @@index([fansPumpXp])
  @@index([isFeatured])
  @@map("creator_profiles")
}

model CreatorQuest {
  id               String      @id @default(cuid())
  creatorWallet    String      @map("creator_wallet")
  tokenId          String?     @map("token_id")
  tokenAddress     String?     @map("token_address")
  questType        QuestType   @map("quest_type")
  title            String
  description      String      @db.Text
  targetUrl        String?     @map("target_url")
  targetMetric     String?     @map("target_metric")
  targetValue      Int?        @map("target_value")
  rewardXp         Int         @default(10) @map("reward_xp")
  rewardReputation Int         @default(5) @map("reward_reputation")
  status           QuestStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  creator     CreatorProfile  @relation(fields: [creatorWallet], references: [walletAddress], onDelete: Cascade)
  token       TokenProject?   @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  completions QuestCompletion[]

  @@index([creatorWallet])
  @@index([tokenId])
  @@index([status])
  @@map("creator_quests")
}

model QuestCompletion {
  id            String   @id @default(cuid())
  questId       String   @map("quest_id")
  walletAddress String   @map("wallet_address")
  completedAt   DateTime @default(now()) @map("completed_at")

  quest CreatorQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([questId, walletAddress])
  @@index([walletAddress])
  @@map("quest_completions")
}

model TokenDailySnapshot {
  id             String   @id @default(cuid())
  tokenId        String   @map("token_id")
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  holderCount    Int      @default(0) @map("holder_count")
  liquidityScore Float    @default(0) @map("liquidity_score")
  volume24h      Float    @default(0) @map("volume_24h")
  trustScore     Float    @default(0) @map("trust_score")
  createdAt      DateTime @default(now()) @map("created_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, snapshotDate])
  @@index([tokenId])
  @@index([snapshotDate])
  @@map("token_daily_snapshots")
}

model TrustScoreHistory {
  id         String   @id @default(cuid())
  tokenId    String   @map("token_id")
  trustScore Float    @map("trust_score")
  breakdown  Json
  recordedAt DateTime @default(now()) @map("recorded_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([recordedAt])
  @@map("trust_score_history")
}

model Bounty {
  id                String           @id @default(cuid())
  creatorWallet     String           @map("creator_wallet")
  tokenId           String?          @map("token_id")
  tokenAddress      String?          @map("token_address")
  title             String
  description       String           @db.Text
  taskType          BountyTaskType   @default(CUSTOM) @map("task_type")
  requirements      String?          @db.Text
  rewardType        BountyRewardType @map("reward_type")
  rewardAmount      String           @map("reward_amount")
  rewardDescription String?          @map("reward_description")
  verificationMethod BountyVerificationMethod @default(MANUAL) @map("verification_method")
  verificationConfig Json?           @map("verification_config")
  isFeatured        Boolean          @default(false) @map("is_featured")
  maxParticipants   Int              @map("max_participants")
  participantCount  Int              @default(0) @map("participant_count")
  viewCount         Int              @default(0) @map("view_count")
  status            BountyStatus     @default(ACTIVE)
  startsAt          DateTime         @default(now()) @map("starts_at")
  endsAt            DateTime?        @map("ends_at")
  completedAt       DateTime?        @map("completed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  creator        User                  @relation(fields: [creatorWallet], references: [walletAddress], onDelete: Cascade)
  token          TokenProject?         @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  participations BountyParticipation[]

  @@index([creatorWallet])
  @@index([tokenId])
  @@index([status])
  @@index([endsAt])
  @@index([participantCount])
  @@index([createdAt])
  @@index([isFeatured])
  @@map("bounties")
}

model BountyParticipation {
  id              String                    @id @default(cuid())
  bountyId        String                    @map("bounty_id")
  walletAddress   String                    @map("wallet_address")
  status          BountyParticipationStatus @default(JOINED)
  proofJson       Json?                     @map("proof_json")
  verifiedAt      DateTime?                 @map("verified_at")
  verifiedBy      String?                   @map("verified_by")
  claimedAt       DateTime?                 @map("claimed_at")
  rejectionReason String?                   @map("rejection_reason") @db.Text
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  bounty Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [walletAddress], references: [walletAddress], onDelete: Cascade)

  @@unique([bountyId, walletAddress])
  @@index([walletAddress])
  @@index([bountyId])
  @@map("bounty_participations")
}

enum LaunchpoolStatus {
  ACTIVE
  ONGOING
  ENDED
}

enum ContactInquiryType {
  SUPPORT
  ADVERTISE
}

model Launchpool {
  id                 String           @id @default(cuid())
  title              String
  description        String           @db.Text
  detailInfo         String           @map("detail_info") @db.Text
  status             LaunchpoolStatus @default(ACTIVE)
  rewardTokenSymbol  String           @map("reward_token_symbol")
  rewardTokenAddress String?          @map("reward_token_address")
  totalRewardUsd     Float            @map("total_reward_usd")
  totalRewardAmount  String           @map("total_reward_amount")
  startAt            DateTime         @map("start_at")
  endAt              DateTime         @map("end_at")
  durationLabel      String?          @map("duration_label")
  isPublished        Boolean          @default(true) @map("is_published")
  rewardsDistributed Boolean          @default(false) @map("rewards_distributed")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  stakeAssets LaunchpoolStakeAsset[]
  stakes      LaunchpoolStake[]
  rewards     LaunchpoolReward[]

  @@index([status, isPublished])
  @@map("launchpools")
}

model LaunchpoolStakeAsset {
  id           String  @id @default(cuid())
  launchpoolId String  @map("launchpool_id")
  assetType    String  @map("asset_type")
  assetAddress String? @map("asset_address")
  assetSymbol  String  @map("asset_symbol")

  launchpool Launchpool @relation(fields: [launchpoolId], references: [id], onDelete: Cascade)

  @@unique([launchpoolId, assetSymbol, assetAddress])
  @@map("launchpool_stake_assets")
}

model LaunchpoolStake {
  id            String    @id @default(cuid())
  launchpoolId  String    @map("launchpool_id")
  walletAddress String    @map("wallet_address")
  assetType     String    @map("asset_type")
  assetAddress  String?   @map("asset_address")
  assetSymbol   String    @map("asset_symbol")
  amount        String
  stakedAt      DateTime  @default(now()) @map("staked_at")
  unstakedAt    DateTime? @map("unstaked_at")
  isActive      Boolean   @default(true) @map("is_active")

  launchpool Launchpool @relation(fields: [launchpoolId], references: [id], onDelete: Cascade)

  @@index([launchpoolId, walletAddress, isActive])
  @@map("launchpool_stakes")
}

model LaunchpoolReward {
  id            String    @id @default(cuid())
  launchpoolId  String    @map("launchpool_id")
  walletAddress String    @map("wallet_address")
  amount        String
  tokenSymbol   String    @map("token_symbol")
  tokenAddress  String?   @map("token_address")
  accruedAt     DateTime  @default(now()) @map("accrued_at")
  claimedAt     DateTime? @map("claimed_at")

  launchpool Launchpool @relation(fields: [launchpoolId], references: [id], onDelete: Cascade)

  @@index([walletAddress, claimedAt])
  @@map("launchpool_rewards")
}

model ContactInquiry {
  id        String             @id @default(cuid())
  type      ContactInquiryType
  name      String
  email     String
  subject   String?
  message   String             @db.Text
  wallet    String?            @map("wallet_address")
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("contact_inquiries")
}

model AppAccount {
  id            String   @id @default(cuid())
  email         String?  @unique
  displayName   String?  @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  walletAddress String?  @unique @map("wallet_address")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  identities AppIdentity[]
  sessions   AppSession[]

  @@map("app_accounts")
}

model AppIdentity {
  id             String     @id @default(cuid())
  accountId      String     @map("account_id")
  provider       String
  providerUserId String     @map("provider_user_id")
  email          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  account        AppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([accountId])
  @@map("app_identities")
}

model AppSession {
  id        String     @id @default(cuid())
  accountId String     @map("account_id")
  token     String     @unique
  expiresAt DateTime   @map("expires_at")
  createdAt DateTime   @default(now()) @map("created_at")
  account   AppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("app_sessions")
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("email_otps")
}

/// Wallet-level verification badges (email ✓, NeoID ✦) and quest social OAuth tokens.
model WalletVerification {
  id                String    @id @default(cuid())
  walletAddress     String    @unique @map("wallet_address")

  email             String?
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  emailOtp          String?   @map("email_otp")
  emailOtpExpiresAt DateTime? @map("email_otp_expires_at")

  neoIdVerified     Boolean   @default(false) @map("neo_id_verified")
  neoIdAddress      String?   @map("neo_id_address")
  neoIdVerifiedAt   DateTime? @map("neo_id_verified_at")

  xConnected        Boolean   @default(false) @map("x_connected")
  xUserId           String?   @map("x_user_id")
  xUsername         String?   @map("x_username")
  xAccessToken      String?   @map("x_access_token")
  xConnectedAt      DateTime? @map("x_connected_at")

  discordConnected     Boolean   @default(false) @map("discord_connected")
  discordUserId        String?   @map("discord_user_id")
  discordUsername      String?   @map("discord_username")
  discordAccessToken   String?   @map("discord_access_token")
  discordConnectedAt   DateTime? @map("discord_connected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallet_verifications")
}

/// Cached wallet intelligence scans from TrustScan.
model WalletScan {
  id        String   @id @default(cuid())
  address   String   @unique
  riskLevel String   @map("risk_level")
  riskScore Float    @map("risk_score")
  data      Json
  scannedAt DateTime @default(now()) @map("scanned_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scannedAt])
  @@map("wallet_scans")
}
