generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VoteType {
  BULLISH
  NEUTRAL
  BEARISH
}

enum EarningType {
  TRADING_FEE
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  SUPPORT
  VIEWER
}

enum TokenVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum TreasuryWalletType {
  EOA
  SAFE_MULTISIG
}

enum TokenCategory {
  MEME
  GAMING
  AI
  DEFI
  INFRASTRUCTURE
  NFT
  COMMUNITY
  UTILITY
  OTHER
}

enum AnnouncementType {
  VERSION_RELEASE
  PARTNERSHIP
  LIQUIDITY_ADDED
  EXCHANGE_LISTING
  MARKETING_UPDATE
  COMMUNITY_UPDATE
  GENERAL
}

enum StakingAssetType {
  OPN
  LP_TOKEN
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique @map("wallet_address")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  watchlist     WatchlistItem[]
  votes         TokenVote[]
  verification  CreatorVerification?
  tokenProjects TokenProject[]

  @@map("users")
}

model TokenProject {
  id              String   @id @default(cuid())
  contractAddress String   @unique @map("contract_address")
  chainId         Int      @map("chain_id")
  name            String
  symbol          String
  decimals        Int      @default(18)
  initialSupply   String   @map("initial_supply")
  featureFlags    BigInt   @map("feature_flags")
  creatorAddress  String   @map("creator_address")
  factoryAddress  String   @map("factory_address")
  txHash          String?  @map("tx_hash")

  logoUrl         String?  @map("logo_url")
  bannerUrl       String?  @map("banner_url")
  description     String?  @db.Text
  website         String?
  telegram        String?
  twitter         String?
  discord         String?
  github          String?

  buyTaxBps       Int?     @map("buy_tax_bps")
  sellTaxBps      Int?     @map("sell_tax_bps")
  maxWallet       String?  @map("max_wallet")
  maxTx           String?  @map("max_tx")

  viewCount       Int      @default(0) @map("view_count")
  holderCount     Int      @default(0) @map("holder_count")
  isFeatured      Boolean  @default(false) @map("is_featured")
  trendingScore   Float    @default(0) @map("trending_score")
  verificationStatus TokenVerificationStatus @default(NONE) @map("verification_status")
  verificationSubmittedAt DateTime? @map("verification_submitted_at")
  isHidden        Boolean  @default(false) @map("is_hidden")
  isScam          Boolean  @default(false) @map("is_scam")

  volume24h       Float    @default(0) @map("volume_24h")
  volumeTotal     Float    @default(0) @map("volume_total")
  txCount24h      Int      @default(0) @map("tx_count_24h")
  txCountTotal    Int      @default(0) @map("tx_count_total")
  lastActivity    DateTime? @map("last_activity")
  poolStrength    Float    @default(0) @map("pool_strength")
  category        TokenCategory @default(OTHER)
  ownershipRenounced Boolean @default(false) @map("ownership_renounced")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator         User?    @relation(fields: [creatorAddress], references: [walletAddress])
  votes           TokenVote[]
  watchlist       WatchlistItem[]
  metadataHistory MetadataUpdate[]
  liquidityLocks  LiquidityLock[]
  lpBurns         LpBurn[]
  creatorEarnings CreatorEarning[]
  poolStats       TokenPoolStats?
  swapActivities  SwapActivity[]
  announcements   TokenAnnouncement[]

  @@index([category])

  @@index([createdAt])
  @@index([volume24h])
  @@index([txCount24h])
  @@index([lastActivity])
  @@index([poolStrength])
  @@index([chainId])
  @@index([creatorAddress])
  @@index([chainId, creatorAddress])
  @@index([chainId, createdAt])
  @@index([trendingScore])
  @@index([viewCount])
  @@index([holderCount])
  @@index([updatedAt])
  @@index([isFeatured])
  @@map("token_projects")
}

model LiquidityLock {
  id            String   @id @default(cuid())
  tokenId       String   @map("token_id")
  tokenAddress  String   @map("token_address")
  lpToken       String   @map("lp_token")
  lockerAddress String   @map("locker_address")
  creatorWallet String   @map("creator_wallet")
  amount        String   @map("amount") // raw LP amount (uint256) as string
  unlockAt      DateTime @map("unlock_at")
  txHash        String?  @map("tx_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  token         TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([tokenAddress])
  @@index([lpToken])
  @@index([creatorWallet])
  @@index([unlockAt])
  @@map("liquidity_locks")
}

model LpBurn {
  id            String   @id @default(cuid())
  tokenId       String   @map("token_id")
  tokenAddress  String   @map("token_address")
  lpToken       String   @map("lp_token")
  creatorWallet String   @map("creator_wallet")
  amount        String   @map("amount") // raw LP amount (uint256) as string
  burnAddress   String   @default("0x000000000000000000000000000000000000dEaD") @map("burn_address")
  txHash        String?  @map("tx_hash")
  burnedAt      DateTime @default(now()) @map("burned_at")

  token         TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([tokenAddress])
  @@index([lpToken])
  @@index([creatorWallet])
  @@map("lp_burns")
}

model CreatorVerification {
  id              String   @id @default(cuid())
  walletAddress   String   @unique @map("wallet_address")
  signature       String
  message         String
  verifiedAt      DateTime @default(now()) @map("verified_at")

  user            User     @relation(fields: [walletAddress], references: [walletAddress])

  @@map("creator_verifications")
}

model WatchlistItem {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  tokenId       String   @map("token_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@map("watchlist_items")
}

model TokenVote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenId   String   @map("token_id")
  voteType  VoteType @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@map("token_votes")
}

model MetadataUpdate {
  id        String   @id @default(cuid())
  tokenId   String   @map("token_id")
  field     String
  createdAt DateTime @default(now()) @map("created_at")

  token     TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@map("metadata_updates")
}

/// Off-chain creator trading fee ledger (event-indexed, not on-chain yet).
model CreatorEarning {
  id             String      @id @default(cuid())
  creatorAddress String      @map("creator_address")
  tokenId        String      @map("token_id")
  tokenAddress   String      @map("token_address")
  amount         String
  earningType    EarningType @default(TRADING_FEE) @map("earning_type")
  txHash         String?     @map("tx_hash")
  logIndex       Int?        @map("log_index")
  blockNumber    BigInt?     @map("block_number")
  createdAt      DateTime    @default(now()) @map("created_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([creatorAddress])
  @@index([tokenAddress])
  @@index([tokenId])
  @@index([createdAt])
  @@map("creator_earnings")
}

/// Simulated pool share accumulator (AMM migration prep — off-chain only).
model TokenPoolStats {
  id                   String   @id @default(cuid())
  tokenId              String   @unique @map("token_id")
  tokenAddress         String   @unique @map("token_address")
  accumulatedPoolValue String   @default("0") @map("accumulated_pool_value")
  poolReserveEstimate  String   @default("0") @map("pool_reserve_estimate")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenAddress])
  @@map("token_pool_stats")
}

/// Indexed swap activity for analytics (deduped by tx + log index).
model SwapActivity {
  id            String   @id @default(cuid())
  tokenId       String   @map("token_id")
  tokenAddress  String   @map("token_address")
  traderAddress String   @map("trader_address")
  volumeWei     String   @map("volume_wei")
  txHash        String   @map("tx_hash")
  logIndex      Int      @map("log_index")
  blockNumber   BigInt   @map("block_number")
  blockTime     DateTime @map("block_time")
  createdAt     DateTime @default(now()) @map("created_at")

  token TokenProject @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([txHash, logIndex])
  @@index([tokenAddress])
  @@index([traderAddress])
  @@index([blockTime])
  @@index([tokenId])
  @@map("swap_activities")
}

/// Platform-wide treasury fee accumulator (off-chain ledger).
model PlatformTreasuryLedger {
  id        String      @id @default("global")
  totalWei  String      @default("0") @map("total_wei")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("platform_treasury_ledger")
}

model AdminProfile {
  id            String    @id @default(cuid())
  walletAddress String    @unique @map("wallet_address")
  role          AdminRole @default(SUPER_ADMIN)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("admin_profiles")
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  adminWallet String   @map("admin_wallet")
  action      String
  details     Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminWallet])
  @@index([createdAt])
  @@index([action])
  @@map("admin_activity_logs")
}

model TokenAnnouncement {
  id            String           @id @default(cuid())
  tokenId       String           @map("token_id")
  tokenAddress  String           @map("token_address")
  creatorWallet String           @map("creator_wallet")
  title         String
  content       String           @db.Text
  type          AnnouncementType
  isHidden      Boolean          @default(false) @map("is_hidden")
  createdAt     DateTime         @default(now()) @map("created_at")

  token         TokenProject     @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId])
  @@index([tokenAddress])
  @@index([creatorWallet])
  @@index([createdAt])
  @@map("token_announcements")
}

/// Off-chain stake position tracking (no reward distribution yet).
model StakingPosition {
  id         String           @id @default(cuid())
  wallet     String
  assetType  StakingAssetType @map("asset_type")
  asset      String
  amount     String
  tier       String?
  stakedAt   DateTime         @default(now()) @map("staked_at")
  unstakedAt DateTime?        @map("unstaked_at")
  isActive   Boolean          @default(true) @map("is_active")

  @@index([wallet])
  @@index([asset])
  @@index([isActive])
  @@map("staking_positions")
}

/// Key-value platform configuration (fees, treasury, discovery weights, etc.).
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}
