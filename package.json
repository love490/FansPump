{
  "name": "iopn-launch",
  "version": "1.0.0",
  "private": true,
  "description": "IOPn Launch — token creation, discovery, ownership & liquidity onboarding",
  "scripts": {
    "dev": "pnpm --filter @iopn/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @iopn/contracts test",
    "postinstall": "pnpm db:generate",
    "db:generate": "pnpm --filter @iopn/database generate",
    "db:push": "pnpm --filter @iopn/database push",
    "db:migrate": "pnpm --filter @iopn/database migrate",
    "db:studio": "pnpm --filter @iopn/database studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
