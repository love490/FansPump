{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm db:generate && pnpm --filter @iopn/web build"
  },
  "deploy": {
    "startCommand": "pnpm db:push && pnpm --filter @iopn/web start",
    "restartPolicyType": "ON_FAILURE"
  },
  "environment": {
    "NODE_VERSION": "22"
  }
}
